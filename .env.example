# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

# --- PostgreSQL (эти же значения читает приложение) ---
POSTGRES_USER=guestbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guestbook

# --- Адрес базы для приложения ---
# При запуске через docker compose DB_HOST переопределяется на имя сервиса `db`.
DB_HOST=localhost
DB_PORT=5432

# --- Приложение ---
GREETING=Добро пожаловать в гостевую книгу!
# Порт на хосте, на котором будет доступно приложение
APP_PORT=8000
